{
  "name": "pi-provider-phala-cloud",
  "version": "0.2.0",
  "description": "Phala Cloud Confidential AI for Pi — attested TLS (SPKI) pinning (prevention)",
  "keywords": [
    "ai-provider",
    "attestation",
    "confidential-ai",
    "phala",
    "phala-cloud",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-provider",
    "tee",
    "verifiable"
  ],
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "index.ts",
    "core",
    "package.json",
    "README.md",
    "LICENSE",
    "SOURCE.json",
    ".npmrc"
  ],
  "scripts": {
    "start": "pi -e .",
    "pretest": "node -e \"console.log('no unit tests in artifact; run SoT clients/pi-provider')\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@phala/aci-verifier": "0.11.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Phala-Network/pi-provider-phala-cloud"
  },
  "sot": {
    "monorepo": "https://github.com/Dstack-TEE/private-ai-gateway",
    "kernel": "@phala/pi-provider-aci",
    "verifier": "@phala/aci-verifier@0.11.0 (npm dependency)",
    "brand": "phala-cloud",
    "oauth": true
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@types/node": "^24.19.2",
    "typescript": "5.9"
  },
  "overrides": {
    "@aws-sdk/client-bedrock-runtime": "file:./stubs/empty",
    "@smithy/node-http-handler": "file:./stubs/empty",
    "http-proxy-agent": "file:./stubs/empty",
    "https-proxy-agent": "file:./stubs/empty",
    "@google/genai": "file:./stubs/google-genai",
    "@anthropic-ai/sdk": "file:./stubs/anthropic-sdk",
    "quickjs-wasi": "file:./stubs/empty",
    "chalk": "file:./stubs/empty",
    "cross-spawn": "file:./stubs/empty",
    "diff": "file:./stubs/empty",
    "hosted-git-info": "file:./stubs/empty",
    "ignore": "file:./stubs/empty",
    "proper-lockfile": "file:./stubs/empty"
  }
}
