{
  "name": "pi-provider-phala-cloud",
  "version": "0.2.0",
  "description": "Phala Cloud Confidential AI for Pi — attested TLS (SPKI) pinning (prevention)",
  "keywords": [
    "ai-provider",
    "attestation",
    "confidential-ai",
    "phala",
    "phala-cloud",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "pi-provider",
    "tee",
    "verifiable"
  ],
  "license": "MIT",
  "type": "module",
  "private": false,
  "files": [
    "index.ts",
    "core",
    "vendor",
    "package.json",
    "README.md",
    "LICENSE",
    "SOURCE.json",
    ".npmrc"
  ],
  "scripts": {
    "start": "pi -e .",
    "pretest": "node -e \"console.log('no unit tests in artifact; run SoT clients/pi-provider')\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@phala/aci-verifier": "0.11.0",
    "undici": "8.12.4"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Phala-Network/pi-provider-phala-cloud"
  },
  "sot": {
    "monorepo": "https://github.com/Dstack-TEE/private-ai-gateway",
    "kernel": "@phala/pi-provider-aci",
    "verifier": "@phala/aci-verifier@0.1.0",
    "brand": "phala-cloud",
    "oauth": true
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0"
  }
}
